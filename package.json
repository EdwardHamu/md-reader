{
  "name": "md-reader",
  "private": true,
  "version": "0.3.10",
  "type": "module",
  "description": "Minimal read-only Markdown desktop reader with bounded single-document loading.",
  "author": "Neilooo",
  "license": "MIT",
  "homepage": "https://github.com/Neilooo/md-reader#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neilooo/md-reader.git"
  },
  "bugs": {
    "url": "https://github.com/Neilooo/md-reader/issues"
  },
  "keywords": [
    "markdown",
    "reader",
    "viewer",
    "desktop",
    "tauri",
    "vue3",
    "rust"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "test": "node --experimental-strip-types --test tests/reader.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "dompurify": "^3.2.3",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.8.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10",
    "@playwright/test": "^1.58.2"
  }
}
